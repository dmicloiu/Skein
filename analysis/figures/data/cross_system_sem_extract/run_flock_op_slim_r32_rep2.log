-- EXPERIMENT extraction-throughput query (cross-system sem_extract comparison).
-- A projected llm_complete over reviewText (sentiment classification), rewritable
-- to the async PhysicalSemExtract operator. Evaluated as macro precision/recall/f1
-- of the predicted label against gold_sql/Q103.sql (scoreSentiment).
SELECT r.reviewId, llm_complete(
      {'model_name': 'Qwen/Qwen2.5-7B-Instruct'},
      {'prompt': 'Classify the sentiment of this movie review as exactly one of POSITIVE or NEGATIVE. Answer with only the single word POSITIVE or NEGATIVE.',
       'context_columns': [{'data': r.reviewText, 'name': 'review'}]}
  ) AS predicted_sentiment
FROM reviews_2000 AS r;
