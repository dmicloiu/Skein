--- Running flockmtl ---

Running 5 queries for flockmtl
SELECT DISTINCT car_id
FROM car_complaints
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Does this complaint say that the car was in a crash, accident, or collision?',
     'context_columns': [{'data': summary, 'name': 'complaint'}]});
SELECT c.vin
FROM cars AS c
JOIN car_images AS i USING (car_id)
WHERE c.transmission = 'Manual'
  AND llm_filter(
      {'model_name': 'google/gemma-4-26B-A4B-it'},
      {'prompt': 'Does this image show a car or car part without visible damage?',
       'context_columns': [{'data': i.image_path, 'name': 'car image', 'type': 'image'}]})
LIMIT 10;
WITH engine_complaints AS (
    SELECT DISTINCT c.car_id, c.year
    FROM cars AS c
    JOIN car_complaints AS t USING (car_id)
    WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the complaint describe an engine problem or a problem connected to the engine?',
         'context_columns': [{'data': t.summary, 'name': 'complaint'}]})
)
SELECT 2026 - AVG(year) AS average_age
FROM engine_complaints;
SELECT car_id
FROM car_images
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Does the image show both puncture damage and paint scratches on the car or its parts?',
     'context_columns': [{'data': image_path, 'name': 'car image', 'type': 'image'}]})
LIMIT 100;
SELECT c.car_id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'Classify the car complaint into exactly one category: ELECTRICAL SYSTEM, POWER TRAIN, ENGINE, STEERING, SERVICE BRAKES, STRUCTURE, AIR BAGS, ENGINE AND ENGINE COOLING, VEHICLE SPEED CONTROL, VISIBILITY/WIPER, FUEL/PROPULSION SYSTEM, FORWARD COLLISION AVOIDANCE, EXTERIOR LIGHTING, SUSPENSION, FUEL SYSTEM, VISIBILITY, WHEELS, SEAT BELTS, BACK OVER PREVENTION, TIRES, SEATS, LATCHES/LOCKS/LINKAGES, LANE DEPARTURE, EQUIPMENT. Return only the category name.',
            'context_columns': [{'data': t.summary, 'name': 'complaint'}]}
       ) AS problem_category
FROM cars AS c
JOIN car_complaints AS t USING (car_id);
