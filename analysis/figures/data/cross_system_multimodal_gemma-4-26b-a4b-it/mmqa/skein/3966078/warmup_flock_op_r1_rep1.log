Running 11 queries for flockmtl
WITH extracted AS (
    SELECT title,
           llm_complete(
               {'model_name': 'google/gemma-4-26B-A4B-it'},
               {'prompt': 'Who directed this movie? Return only the director name.',
                'context_columns': [{'data': text, 'name': 'movie description'}]}
           ) AS director
    FROM ben_piazza_text_data
)
SELECT e.director
FROM ben_piazza AS b
JOIN extracted AS e ON b.Title = e.title
WHERE b.Role = 'Bob Whitewood';
SELECT t.ID, i.image_filename AS image_id
FROM ap_warrior AS t
JOIN images AS i ON llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Does the image show the logo of the horse racetrack named in the Track field?',
     'context_columns': [
         {'data': t.Track, 'name': 'horse racetrack', 'type': 'text'},
         {'data': i.image_filepath, 'name': 'logo image', 'type': 'image'}
     ]});
WITH matches AS (
    SELECT t.ID, i.image_filename AS image_id, i.image_filepath
    FROM ap_warrior AS t
    JOIN images AS i ON llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the image show the logo of the horse racetrack named in the Track field?',
         'context_columns': [
             {'data': t.Track, 'name': 'horse racetrack', 'type': 'text'},
             {'data': i.image_filepath, 'name': 'logo image', 'type': 'image'}
         ]})
)
SELECT ID, image_id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'What is the color of the logo in this image? Return only the color.',
            'context_columns': [{'data': image_filepath, 'name': 'logo image', 'type': 'image'}]}
       ) AS color
FROM matches;
SELECT title
FROM lizzy_caplan_text_data
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Is this a comedy movie?',
     'context_columns': [
         {'data': title, 'name': 'movie title'},
         {'data': text, 'name': 'movie description'}
     ]});
SELECT title
FROM lizzy_caplan_text_data
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Is this a romantic comedy movie?',
     'context_columns': [
         {'data': title, 'name': 'movie title'},
         {'data': text, 'name': 'movie description'}
     ]});
WITH target_movies AS (
    SELECT title, text
    FROM lizzy_caplan_text_data
    WHERE title IN (
        'Orange County', 'Mean Girls', 'Love Is the Drug', 'Crashing', 'Cloverfield',
        'My Best Friend''s Girl', 'Crossing Over', 'Hot Tub Time Machine',
        'The Last Rites of Ransom Pride', '127 Hours', 'High Road', 'Save the Date',
        'Bachelorette', '3, 2, 1... Frankie Go Boom', 'Queens of Country',
        'Item 47', 'The Interview', 'The Night Before', 'Now You See Me 2',
        'Allied', 'The Disaster Artist', 'Extinction',
        'The People We Hate at the Wedding', 'Cobweb'
    )
),
extracted AS (
    SELECT title,
           llm_complete(
               {'model_name': 'google/gemma-4-26B-A4B-it'},
               {'prompt': 'List the genres of this movie, separated by commas. Return only the genre names.',
                'context_columns': [{'data': text, 'name': 'movie description'}]}
           ) AS genres
    FROM target_movies
),
expanded AS (
    SELECT title, trim(genre) AS genre
    FROM extracted, UNNEST(string_split(genres, ',')) AS g(genre)
)
SELECT genre, string_agg(title, ', ' ORDER BY title) AS movies_in_genre
FROM expanded
GROUP BY genre;
WITH target_movies AS (
    SELECT title, text
    FROM lizzy_caplan_text_data
    WHERE title IN (
        'Love Is the Drug', 'Crashing', 'Cloverfield', 'My Best Friend''s Girl',
        'Hot Tub Time Machine', 'The Last Rites of Ransom Pride', 'Save the Date',
        'Bachelorette', '3, 2, 1... Frankie Go Boom', 'Queens of Country',
        'Item 47', 'The Night Before', 'Now You See Me 2', 'Allied',
        'Extinction', 'Cobweb'
    )
),
movie_context AS (
    SELECT string_agg(
        'Movie: ' || title || chr(10) || 'Description: ' || text,
        chr(10) || chr(10) ORDER BY title
    ) AS descriptions
    FROM target_movies
)
SELECT llm_complete(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Who played a role in every movie listed here? Return only the actor name.',
     'context_columns': [
         {'data': descriptions, 'name': 'movie descriptions'}
     ]}) AS _output
FROM movie_context;
