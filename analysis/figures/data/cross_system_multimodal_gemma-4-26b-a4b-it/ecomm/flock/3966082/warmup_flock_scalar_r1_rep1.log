       ) AS category
FROM products;
SELECT i.id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'Extract the primary color of the product in the image. Return only the base color.',
            'context_columns': [{'data': i.local_image_path, 'name': 'product image', 'type': 'image'}]}
       ) AS category
FROM image_mapping AS i
JOIN styles_details AS s ON s.id = i.id::BIGINT
WHERE s.baseColour IN ('Black', 'Blue', 'Red', 'White', 'Orange', 'Green');
WITH products AS (
    SELECT id, productDisplayName || ' ' || productDescriptors.description.value AS description
    FROM styles_details
    WHERE masterCategory.typeName = 'Apparel'
      AND subCategory.typeName NOT IN ('Saree', 'Apparel Set', 'Loungewear and Nightwear')
)
SELECT id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'Classify the product as exactly one of Dress, Bottomwear, Socks, Topwear, or Innerwear. Return only the category name.',
            'context_columns': [{'data': description, 'name': 'product description'}]}
       ) AS category
FROM products;
SELECT i.id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'Classify the pictured product as exactly one of Dress, Bottomwear, Socks, Topwear, or Innerwear. Return only the category name.',
            'context_columns': [{'data': i.local_image_path, 'name': 'product image', 'type': 'image'}]}
       ) AS category
FROM image_mapping AS i
JOIN styles_details AS s ON s.id = i.id::BIGINT
WHERE s.masterCategory.typeName = 'Apparel'
  AND s.subCategory.typeName NOT IN ('Saree', 'Apparel Set', 'Loungewear and Nightwear');
-- SemBench e-commerce Q7: directed product self-join, including self-pairs.
-- Preserve the benchmark's price <= 500 predicate and full n x n pair space.
-- Project the nested description before the join so both context columns
-- are ordinary left/right references for Skein's unkeyed-join rewrite.
WITH product_selection AS (
    SELECT id,
           productDisplayName || ' - ' || productDescriptors.description.value
               AS product_description
    FROM styles_details
    WHERE price <= 500
)
SELECT p1.id::VARCHAR || '-' || p2.id::VARCHAR AS id
FROM product_selection AS p1
JOIN product_selection AS p2
  ON llm_filter(
      {'model_name': 'google/gemma-4-26B-A4B-it'},
      {'prompt': 'You will be given two product descriptions. Do both product descriptions describe products of the same category from the same brand, e.g., both are t-shirts from Adidas?',
       'context_columns': [
           {'data': p1.product_description, 'name': 'first product description'},
           {'data': p2.product_description, 'name': 'second product description'}
       ]});
WITH descriptions AS (
    SELECT id,
           productDisplayName || ' ' || productDescriptors.description.value AS description
    FROM styles_details
    WHERE character_length(productDescriptors.description.value) >= 3000
)
SELECT d.id::VARCHAR || '-' || i.id::VARCHAR AS id
FROM descriptions AS d
JOIN image_mapping AS i
  ON llm_filter(
      {'model_name': 'google/gemma-4-26B-A4B-it'},
      {'prompt': 'Does the product image fit the product description?',
       'context_columns': [
           {'data': d.description, 'name': 'product description', 'type': 'text'},
           {'data': i.local_image_path, 'name': 'product image', 'type': 'image'}
       ]});
WITH selected_images AS (
    SELECT s.id, i.local_image_path
    FROM styles_details AS s
    JOIN image_mapping AS i USING (id)
    WHERE s.baseColour IN ('Black', 'Blue', 'Red', 'White', 'Orange', 'Green')
      AND s.colour1 = '' AND s.colour2 = '' AND s.price < 800
)
SELECT i1.id::VARCHAR || '-' || i2.id::VARCHAR AS id
FROM selected_images AS i1
JOIN selected_images AS i2
  ON i1.id <> i2.id
 AND llm_filter(
      {'model_name': 'google/gemma-4-26B-A4B-it'},
      {'prompt': 'Do the two images show objects of the same category and the same dominant surface color? Ignore logos, text, and printed graphics. Focus on the main object.',
       'context_columns': [
           {'data': i1.local_image_path, 'name': 'first product image', 'type': 'image'},
           {'data': i2.local_image_path, 'name': 'second product image', 'type': 'image'}
       ]});
WITH products AS (
    SELECT s.id, s.productDisplayName || ' ' || s.productDescriptors.description.value AS description,
           i.local_image_path
    FROM styles_details AS s
    JOIN image_mapping AS i ON s.id = i.id::BIGINT
    WHERE s.baseColour IN ('Black', 'Blue', 'Red', 'White') AND s.price <= 1000
),
footwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the main product in the image belong on the feet, such as shoes, sandals, or flip-flops?',
         'context_columns': [{'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
bottomwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the main product in the image belong on the lower body, such as pants, shorts, or a skirt?',
         'context_columns': [{'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
topwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the main product in the image belong on the upper body, such as a shirt, pullover, or hoodie, and require separate lower-body clothing?',
         'context_columns': [{'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
shoe_bottom AS (
    SELECT f.id AS shoe_id, b.id AS bottom_id,
           b.description AS bottom_description, b.local_image_path AS bottom_image
    FROM footwear AS f
    JOIN bottomwear AS b ON llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Do these products have the same primary base color and brand?',
         'context_columns': [
             {'data': f.description, 'name': 'first description', 'type': 'text'},
             {'data': f.local_image_path, 'name': 'first image', 'type': 'image'},
             {'data': b.description, 'name': 'second description', 'type': 'text'},
             {'data': b.local_image_path, 'name': 'second image', 'type': 'image'}
         ]})
)
SELECT sb.shoe_id::VARCHAR || '-' || sb.bottom_id::VARCHAR || '-' || t.id::VARCHAR AS id
FROM shoe_bottom AS sb
JOIN topwear AS t ON llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Do these products have the same primary base color and brand?',
     'context_columns': [
         {'data': sb.bottom_description, 'name': 'first description', 'type': 'text'},
         {'data': sb.bottom_image, 'name': 'first image', 'type': 'image'},
         {'data': t.description, 'name': 'second description', 'type': 'text'},
         {'data': t.local_image_path, 'name': 'second image', 'type': 'image'}
     ]});
WITH products AS (
    SELECT s.id, s.productDisplayName || ' ' || s.productDescriptors.description.value AS description,
           i.local_image_path, s.price
    FROM styles_details AS s
    JOIN image_mapping AS i ON s.id = i.id::BIGINT
),
footwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Is the main product black footwear, such as shoes, sandals, or flip-flops?',
         'context_columns': [
             {'data': description, 'name': 'description', 'type': 'text'},
             {'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
bottomwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Is the main product black lower-body clothing, such as pants, shorts, or a skirt, excluding swimwear?',
         'context_columns': [
             {'data': description, 'name': 'description', 'type': 'text'},
             {'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
topwear AS (
    SELECT * FROM products WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Is the main product black upper-body clothing that requires separate lower-body clothing, excluding swimwear?',
         'context_columns': [
             {'data': description, 'name': 'description', 'type': 'text'},
             {'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
accessories AS (
    SELECT * FROM products WHERE price <= 500 AND llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Is the main product an accessory such as a watch, jewellery, or a bag?',
         'context_columns': [
             {'data': description, 'name': 'description', 'type': 'text'},
             {'data': local_image_path, 'name': 'image', 'type': 'image'}]})
),
shoe_accessory AS (
    SELECT f.id AS shoe_id, a.id AS accessory_id,
           a.description AS accessory_description, a.local_image_path AS accessory_image
    FROM footwear AS f JOIN accessories AS a ON llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Are these two products from the same brand?',
         'context_columns': [
             {'data': f.description, 'name': 'first description', 'type': 'text'},
             {'data': f.local_image_path, 'name': 'first image', 'type': 'image'},
             {'data': a.description, 'name': 'second description', 'type': 'text'},
             {'data': a.local_image_path, 'name': 'second image', 'type': 'image'}]})
),
bottom_top AS (
    SELECT b.id AS bottom_id, t.id AS top_id,
           b.description AS bottom_description, b.local_image_path AS bottom_image
    FROM bottomwear AS b JOIN topwear AS t ON llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Are these two products from the same brand?',
         'context_columns': [
             {'data': b.description, 'name': 'first description', 'type': 'text'},
             {'data': b.local_image_path, 'name': 'first image', 'type': 'image'},
             {'data': t.description, 'name': 'second description', 'type': 'text'},
             {'data': t.local_image_path, 'name': 'second image', 'type': 'image'}]})
)
SELECT sa.shoe_id::VARCHAR || '-' || bt.bottom_id::VARCHAR || '-' ||
       bt.top_id::VARCHAR || '-' || sa.accessory_id::VARCHAR AS id
FROM shoe_accessory AS sa
JOIN bottom_top AS bt ON llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Are these two products from the same brand?',
     'context_columns': [
         {'data': sa.accessory_description, 'name': 'first description', 'type': 'text'},
         {'data': sa.accessory_image, 'name': 'first image', 'type': 'image'},
         {'data': bt.bottom_description, 'name': 'second description', 'type': 'text'},
         {'data': bt.bottom_image, 'name': 'second image', 'type': 'image'}]});
