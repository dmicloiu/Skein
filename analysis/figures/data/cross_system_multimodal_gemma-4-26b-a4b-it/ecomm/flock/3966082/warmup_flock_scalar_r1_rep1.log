WITH products AS (
    SELECT id,
           productDisplayName || ' ' || productDescriptors.description.value AS description
    FROM styles_details
)
SELECT id
FROM products
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'The product is a backpack from Reebok.',
     'context_columns': [
         {'data': description, 'name': 'product description'}
     ]});
SELECT image_mapping.id AS id
FROM styles_details
JOIN image_mapping USING (id)
WHERE llm_filter(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'The image shows a pair of sports shoes featuring yellow and silver colors.',
     'context_columns': [
         {'data': local_image_path, 'name': 'product image', 'type': 'image'}
     ]});
WITH products AS (
    SELECT id, productDisplayName || ' ' || productDescriptors.description.value AS description
    FROM styles_details
)
SELECT id,
       llm_complete(
           {'model_name': 'google/gemma-4-26B-A4B-it'},
           {'prompt': 'Extract the brand name from this product title and description. Return only the brand name.',
