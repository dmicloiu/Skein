WITH products AS (
    SELECT s.id, s.id::VARCHAR AS id_text,
           s.productDisplayName || ' ' || s.productDescriptors.description.value AS description,
           i.local_image_path
    FROM styles_details AS s
    JOIN image_mapping AS i ON s.id = i.id::BIGINT
    WHERE s.masterCategory.typeName IN ('Accessories', 'Apparel', 'Footwear')
),
filtered AS (
    SELECT * FROM products
    WHERE llm_filter(
        {'model_name': 'google/gemma-4-26B-A4B-it'},
        {'prompt': 'Does the product description identify an Adidas or Puma product?',
         'context_columns': [{'data': description, 'name': 'product description'}]})
)
SELECT llm_complete(
    {'model_name': 'google/gemma-4-26B-A4B-it'},
    {'prompt': 'Using the product ID, description, and image, return a single-line JSON object with keys id (integer), brand (lowercase), category (one of accessories, apparel, footwear), in that order, with no spaces.',
     'context_columns': [
         {'data': id_text, 'name': 'product id', 'type': 'text'},
         {'data': description, 'name': 'product description', 'type': 'text'},
         {'data': local_image_path, 'name': 'product image', 'type': 'image'}
     ]}) AS id
FROM filtered;
