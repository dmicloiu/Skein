Running 4 queries for flockmtl
SELECT COUNT(*) AS count
FROM ImageData
WHERE llm_filter(
    {'model_name': 'Qwen/Qwen2.5-Omni-7B'},
    {'prompt': 'Does this image show a zebra?',
     'context_columns': [{'data': image, 'name': 'wildlife image', 'type': 'image'}]});
WITH zebras AS (
    SELECT city
    FROM ImageData
    WHERE llm_filter(
        {'model_name': 'Qwen/Qwen2.5-Omni-7B'},
        {'prompt': 'Does this image show a zebra?',
         'context_columns': [{'data': image, 'name': 'wildlife image', 'type': 'image'}]})
)
SELECT city
FROM zebras
GROUP BY city
ORDER BY COUNT(*) DESC, city
LIMIT 1;
WITH zebras AS (
    SELECT city
    FROM ImageData
    WHERE llm_filter(
        {'model_name': 'Qwen/Qwen2.5-Omni-7B'},
        {'prompt': 'Does this image show a zebra?',
         'context_columns': [{'data': image, 'name': 'wildlife image', 'type': 'image'}]})
),
impalas AS (
    SELECT city
    FROM ImageData
    WHERE llm_filter(
        {'model_name': 'Qwen/Qwen2.5-Omni-7B'},
        {'prompt': 'Does this image show an impala?',
         'context_columns': [{'data': image, 'name': 'wildlife image', 'type': 'image'}]})
)
SELECT city FROM zebras
INTERSECT
SELECT city FROM impalas;
WITH zebras AS (
    SELECT city, stationID
    FROM ImageData
    WHERE llm_filter(
        {'model_name': 'Qwen/Qwen2.5-Omni-7B'},
        {'prompt': 'Does this image show a zebra?',
         'context_columns': [{'data': image, 'name': 'wildlife image', 'type': 'image'}]})
)
SELECT city, stationID
FROM zebras
GROUP BY city, stationID
ORDER BY COUNT(*) DESC, city, stationID
LIMIT 1;
